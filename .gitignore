# Dependencies
node_modules/

# Downloaded toolchain Release assets (binaries, skills, visualizer, wire-types)
dist-assets/

# VS Code extension build artifacts (staged/compiled at publish time)
packages/vscode/out/
packages/vscode/dist/
packages/vscode/bin/
packages/vscode/skills/
*.vsix

# Claude Code plugin payload — staged from the downloaded skills tarball
packages/npm/claude-plugin/skills/
# Plugin agents/ — hoisted at build (make stage-agents) from the skills tarball's
# canonical subagent files, single-sourced in the toolchain repo. Never committed.
packages/npm/claude-plugin/agents/

# Composed package READMEs — generated build output (render-docs). Canonical
# source is the toolchain doc fragments + docs/templates/ here. Never hand-edit.
# (The repo-root README.md is ALSO composed by render-docs, but it is the
# committed storefront landing page GitHub renders, so it stays tracked — edit
# docs/templates/root.md, not README.md, then re-render + commit.)
packages/vscode/README.md
packages/npm/twf/README.md
packages/pypi/twf-cli/README.md
packages/npm/claude-plugin/README.md

# npm platform sub-package binaries (staged at publish time)
packages/npm/twf-*/bin/twf
packages/npm/twf-*/bin/twf.exe

# LICENSE copies generated by package prepack hooks (canonical copy at repo root)
packages/npm/twf*/LICENSE
packages/npm/claude-plugin/LICENSE

# PyPI build output + staged binary
packages/pypi/twf-cli/dist/
packages/pypi/twf-cli/src/twf_cli/_binary/

# bump-brew compiled binary
internal/release/bump-brew/bump-brew

# twf-view cross-compile output (archives + per-platform binaries) and the
# stray binary a bare `go build` drops at the module root. The embedded UI bundle
# at packages/twf-view/ui/index.html is DELIBERATELY tracked (go install must
# have an asset to embed) — only the compiled binaries here are build artifacts.
packages/twf-view/dist/
packages/twf-view/twf-view
packages/twf-view/twf-view.exe

# web-ui single-file bundle — the shared SSE browser entry OWNED here and consumed
# by both twf-view (go:embed copy at packages/twf-view/ui/index.html, tracked
# above) and @temporal-architect/serve (prepack copy into packages/serve/assets/).
# The canonical build output is generated, never committed.
packages/web-ui/dist/

# @temporal-architect/payload + serve build output and prepack copies.
packages/payload/dist/
packages/serve/dist/
packages/serve/assets/

# LICENSE copies generated by the payload/serve prepack hooks (canonical at root).
packages/payload/LICENSE
packages/serve/LICENSE

# Extension lock — generated at build (npm install --install-links); never committed.
packages/vscode/package-lock.json
