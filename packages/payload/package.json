    "directory": "packages/payload"
  },
  "bugs": {
    "url": "https://github.com/jmbarzee/temporal-architect/issues"
  },
  "keywords": [
    "temporal",
    "twf",
    "temporal-architect",
    "visualizer",
    "payload"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepack": "cp ../../LICENSE LICENSE && npm run build",
    "postpack": "rm -f LICENSE"
  },
  "devDependencies": {
