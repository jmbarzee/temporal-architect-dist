{
  "name": "@temporal-architect/serve",
  "version": "0.15.0",
  "description": "Serve the Temporal Architect visualizer over local HTTP, live-reloading as your `.twf` files change. `npx @temporal-architect/serve <tree>` — the Node/npx sibling of the Go `twf-view` binary: it subprocesses the `twf` CLI, assembles the graph payload, and serves the shared visualizer over SSE.",
  "license": "MIT",
  "homepage": "https://github.com/jmbarzee/temporal-architect",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmbarzee/temporal-architect-dist",
    "directory": "packages/serve"
  },
  "bugs": {
    "url": "https://github.com/jmbarzee/temporal-architect/issues"
  },
  "keywords": [
    "temporal",
    "workflow",
    "twf",
    "temporal-architect",
    "visualizer",
    "architecture",
    "system design"
  ],
  "type": "commonjs",
  "bin": {
    "twf-serve": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p . && npm run copy-ui",
    "copy-ui": "node -e \"require('fs').mkdirSync('assets',{recursive:true});require('fs').copyFileSync('../web-ui/dist/index.html','assets/index.html')\"",
    "prepack": "cp ../../LICENSE LICENSE && (cd ../web-ui && npm ci && npm run build) && npm run build",
    "postpack": "rm -f LICENSE"
  },
  "dependencies": {
    "@temporal-architect/payload": "0.15.0",
    "@temporal-architect/twf": "0.15.0",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
